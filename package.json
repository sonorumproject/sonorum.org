    "db:migrate:remote": "wrangler d1 migrations apply sonorum --remote",
    "deploy": "wrangler deploy",
    "check": "node scripts/check-questions.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  },
