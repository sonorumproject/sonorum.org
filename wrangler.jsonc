{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sonorum-org",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonorum",
      "database_id": "95c4c413-93a4-4ac3-8d4e-2e71315ef635",
      "migrations_dir": "./migrations"
    }
  ],
  "ratelimits": [
    // Applied per IP to sign-in, sign-up and reset requests.
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "MAIL_FROM": "hello@sonorum.org",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF61HDUTGq2TndwI"
  },
  "routes": [
    { "pattern": "sonorum.org", "custom_domain": true },
    { "pattern": "www.sonorum.org", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
